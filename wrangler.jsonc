{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kexalo-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "ai": {
    "binding": "AI"
  }
}
